---
import historias from '../data/historias.json';

// Lista de países sin repetir para los botones
const paises = [...new Set(historias.map(item => item.pais))];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<title>Sónica | Cronología Musical</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 min-h-screen font-sans relative overflow-x-hidden selection:bg-purple-500 selection:text-white">
		
		<!-- ⏳ PANTALLA DE CARGA (Preloader) -->
		<div id="loader-pantalla" class="fixed inset-0 bg-black flex flex-col items-center justify-center z-[100] transition-all duration-700 ease-in-out">
			<div class="relative flex flex-col items-center">
				<div class="absolute w-32 h-32 bg-purple-500/20 rounded-full blur-2xl animate-pulse"></div>
				<span class="text-6xl animate-spin [animation-duration:3s] relative z-10 select-none">💿</span>
				<h3 class="text-xs font-mono tracking-[0.2em] uppercase text-purple-400 font-bold mt-6 animate-pulse">SÓNICA</h3>
				<p class="text-[10px] font-mono text-zinc-600 mt-2 tracking-wider">Sintonizando frecuencias...</p>
			</div>
		</div>

		<!-- 🔐 SISTEMA DE USUARIOS: LOGIN Y REGISTRO FLOTANTE -->
		<div id="modal-usuario" class="fixed inset-0 bg-black/90 backdrop-blur-md flex items-center justify-center z-[80] hidden">
			<div class="bg-zinc-900 border border-zinc-800 p-8 rounded-3xl max-w-sm w-full mx-4 shadow-2xl relative">
				<h3 class="text-xl font-black text-white tracking-tight text-center bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent">SÓNICA CLUB</h3>
				<p class="text-zinc-500 text-xs text-center mt-1 mb-6">Iniciá sesión o registrate para guardar tus figuritas.</p>
				
				<div class="space-y-4">
					<div>
						<label class="text-[10px] font-mono text-zinc-500 uppercase block mb-1">Nombre de Usuario</label>
						<input type="text" id="user-input" class="w-full bg-zinc-950 border border-zinc-800 focus:border-purple-500 rounded-xl p-3 text-sm text-white focus:outline-none transition" placeholder="Ej: melomano_99" autocomplete="off" />
					</div>
					<div>
						<label class="text-[10px] font-mono text-zinc-500 uppercase block mb-1">Contraseña</label>
						<input type="password" id="pass-input" class="w-full bg-zinc-950 border border-zinc-800 focus:border-purple-500 rounded-xl p-3 text-sm text-white focus:outline-none transition" placeholder="••••••••" />
					</div>
					
					<button id="btn-auth-confirm" class="w-full bg-purple-600 hover:bg-purple-500 text-white text-xs font-mono font-bold p-3 rounded-xl transition mt-2 shadow-lg shadow-purple-900/30">
						Ingresar / Crear Cuenta
					</button>
				</div>
				<p id="auth-error" class="text-red-400 text-[10px] font-mono text-center mt-3 hidden">⚠️ Datos incorrectos</p>
			</div>
		</div>

		<!-- 👤 BARRA DE ESTADO DEL USUARIO (Al frente de todo) -->
		<div class="fixed top-5 right-6 z-[90] flex items-center gap-3">
			<div id="user-status-bar" class="bg-zinc-900/90 border border-zinc-800 px-4 py-2 rounded-full text-xs font-mono text-zinc-400 flex items-center gap-2 backdrop-blur-md shadow-xl">
				👤 <span id="current-username" class="text-purple-400 font-bold">Invitado</span>
				<button id="btn-logout" class="text-zinc-500 hover:text-red-400 font-bold pl-2 border-l border-zinc-800 transition hidden">Salir</button>
			</div>
		</div>

		<!-- 🌌 Luces de Fondo (Efecto Neón Blur) -->
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[500px] pointer-events-none opacity-20 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-purple-600 via-transparent to-transparent -z-10"></div>

		<!-- 🎸 Barra de Navegación -->
		<header class="border-b border-zinc-900/80 bg-zinc-950/70 backdrop-blur-md sticky top-0 z-30">
			<div class="max-w-5xl mx-auto px-6 h-20 flex items-center justify-between">
				<div class="flex items-center gap-3">
					<span class="text-2xl">⚡</span>
					<h1 class="text-xl font-black tracking-widest bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent">SÓNICA</h1>
				</div>
			</div>
		</header>

		<main class="max-w-5xl mx-auto px-6 py-16">
			
			<!-- 🖼️ Sección Héroe con Buscador Predictivo -->
			<section class="grid md:grid-cols-5 gap-12 items-center mb-16">
				<div class="md:col-span-3 text-left">
					<span class="text-[10px] font-mono tracking-widest text-purple-400 uppercase bg-purple-950/40 border border-purple-800/60 px-4 py-1.5 rounded-full">
						🎛️ Enciclopedia Interactiva de Sonido
					</span>
					<h2 class="text-4xl md:text-6xl font-black tracking-tighter mt-6 mb-4 leading-none bg-gradient-to-b from-white via-zinc-200 to-zinc-500 bg-clip-text text-transparent">
						Viajá a través de las décadas.
					</h2>
					<p class="text-zinc-400 text-sm max-w-lg leading-relaxed mb-8">
						Explorá los géneros, subgéneros e hitos históricos de las bandas más influyentes del mundo.
					</p>

					<!-- 🔍 Buscador Capa z-10 para que no traspase el login -->
					<div class="relative max-w-md z-10">
						<div class="flex items-center gap-3 bg-zinc-900/80 border border-zinc-800 focus-within:border-purple-500 p-3 rounded-2xl shadow-2xl transition duration-300 backdrop-blur-sm">
							<span class="text-zinc-500 text-lg pl-1">🔍</span>
							<input type="text" id="buscador-input" placeholder="Buscar banda, género, país..." class="w-full bg-transparent text-sm text-white focus:outline-none placeholder:text-zinc-600 font-medium" autocomplete="off" />
						</div>
						<div id="buscador-resultados" class="absolute top-full left-0 w-full mt-2 bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl overflow-hidden hidden flex flex-col max-h-60 overflow-y-auto backdrop-blur-lg z-50"></div>
					</div>
				</div>

				<div class="md:col-span-2 relative group w-full aspect-[4/3] md:aspect-square bg-gradient-to-br from-zinc-900 to-zinc-900/40 border border-zinc-800 rounded-3xl overflow-hidden flex flex-col items-center justify-center shadow-2xl p-6">
					<div class="absolute inset-0 bg-[linear-gradient(to_right,#1f1f23_1px,transparent_1px),linear-gradient(to_bottom,#1f1f23_1px,transparent_1px)] bg-[size:24px_24px] opacity-30"></div>
					<span class="text-5xl mb-4 group-hover:scale-110 transition duration-300">💿</span>
					<p class="text-xs font-mono text-zinc-500 tracking-wider uppercase text-center">Espacio para tu Banner</p>
				</div>
			</section>

			<!-- 📅 SECCIÓN: EFEMÉRIDE AUTOMATIZADA -->
			<section id="seccion-efemeride" class="mb-12 hidden">
				<div class="bg-gradient-to-r from-purple-950/40 via-zinc-900/50 to-zinc-900/20 border border-purple-900/50 rounded-2xl p-6 relative overflow-hidden shadow-xl shadow-purple-950/10">
					<div class="absolute -right-10 -bottom-10 w-40 h-40 bg-purple-500/10 rounded-full blur-2xl"></div>
					<div class="flex items-center gap-2 text-purple-400 font-mono text-xs uppercase tracking-widest font-bold mb-4">
						<span>📻</span> Un día como hoy en la música
					</div>
					<div id="efemeride-contenido"></div>
				</div>
			</section>

			<!-- 🎁 LA TIENDA DE SOBRES DEL ÁLBUM -->
			<section class="bg-gradient-to-r from-zinc-900/60 via-purple-950/20 to-zinc-900/40 border border-purple-900/40 rounded-2xl p-6 mb-12 relative overflow-hidden shadow-xl">
				<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 relative z-10">
					<div>
						<span class="text-[10px] font-mono font-bold text-purple-400 uppercase bg-purple-950 px-2 py-0.5 rounded border border-purple-900/60">Álbum Virtual Activado</span>
						<h3 class="text-xl font-black text-white tracking-tight mt-2">¡Reclamá tus sobres diarios!</h3>
						<p class="text-zinc-400 text-xs mt-1">Conseguí 3 figuritas aleatorias para completar tu colección de álbumes sónicos.</p>
					</div>
					
					<div class="flex items-center gap-4 shrink-0">
						<a href="/album" class="bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 text-xs font-mono px-4 py-2.5 rounded-xl transition">
							📔 Ver mi Álbum
						</a>
						<button id="btn-abrir-sobre" class="bg-purple-600 hover:bg-purple-500 text-white text-xs font-mono font-bold px-5 py-2.5 rounded-xl transition shadow-lg shadow-purple-900/30">
							🎁 Abrir Paquete
						</button>
					</div>
				</div>

				<div id="resultado-sobre" class="mt-6 pt-6 border-t border-purple-900/20 relative hidden">
					<button id="btn-cerrar-sobre" class="absolute top-4 right-0 text-zinc-500 hover:text-zinc-300 text-xs font-mono bg-zinc-900 border border-zinc-800 w-6 h-6 rounded-full flex items-center justify-center transition">✕</button>
					<div class="grid grid-cols-3 gap-4"></div>
				</div>
			</section>

			<!-- 🌍 Barra de Filtros por Botones -->
			<section class="bg-zinc-900/20 border border-zinc-900 rounded-2xl p-6 mb-12 backdrop-blur-sm">
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
					<div>
						<h3 class="text-xs font-mono text-zinc-500 uppercase tracking-widest">Filtrar por Origen</h3>
					</div>
					<div class="flex flex-wrap gap-2">
						<button data-pais="todos" class="btn-filtro bg-purple-600 text-white text-xs font-mono font-bold px-5 py-2.5 rounded-xl border border-purple-500 transition shadow-lg shadow-purple-900/30">
							Todos los países
						</button>
						{paises.map(pais => (
							<button data-pais={pais} class="btn-filtro bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 text-xs font-mono px-5 py-2.5 rounded-xl border border-zinc-800 transition">
								{pais}
							</button>
						))}
					</div>
				</div>
			</section>

			<!-- 🎵 Grilla del Catálogo General -->
			<section>
				<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
					{historias.map((artista) => (
						<a href={/${artista.slug}} data-target-pais={artista.pais} class="tarjeta-artista flex flex-col justify-between bg-zinc-900/40 hover:bg-zinc-900 border border-zinc-900 hover:border-zinc-800/80 rounded-2xl transition-all duration-300 hover:-translate-y-1 relative group cursor-pointer overflow-hidden">

							{artista.subgenero}
							{artista.pais}

							{artista.nombre}
							{artista.resumen}

							{artista.periodo}
							Biografía →

							))}

							<script define:vars={{ historias }}>
							// === ⏳ DESVANECIMIENTO DEL PRELOADER ===
							window.addEventListener('load', () => {
							const loader = document.getElementById('loader-pantalla');
							if (loader) {
							setTimeout(() => {
							loader.classList.add('-translate-y-full', 'opacity-0');
							setTimeout(() => loader.remove(), 700);
							}, 3000); // 3 segundos obligatorios
							}
							});

							// === 🔐 MOTOR DE AUTENTICACIÓN LOCAL ===
							const modalAuth = document.getElementById('modal-usuario');
							const userInput = document.getElementById('user-input');
							const passInput = document.getElementById('pass-input');
							const btnAuth = document.getElementById('btn-auth-confirm');
							const authError = document.getElementById('auth-error');
							const labelUser = document.getElementById('current-username');
							const btnLogout = document.getElementById('btn-logout');

							function verificarSesion() {
								const usuarioActivo = sessionStorage.getItem('sesion-usuario-activa');
								if (usuarioActivo) {
									if (labelUser) labelUser.innerText = usuarioActivo;
									if (btnLogout) btnLogout.classList.remove('hidden');
									if (modalAuth) modalAuth.classList.add('hidden');
									} else {
										if (labelUser) labelUser.innerText = "Invitado";
										if (btnLogout) btnLogout.classList.add('hidden');
										if (modalAuth) modalAuth.classList.remove('hidden');
										}
									}

									document.addEventListener('DOMContentLoaded', verificarSesion);

									if (btnAuth) {
										btnAuth.addEventListener('click', () => {
											const username = userInput.value.trim().toLowerCase();
											const password = passInput.value.trim();

											if (!username || !password) {
												authError.innerText = "⚠️ Completá todos los campos";
												authError.classList.remove('hidden');
												return;
											
											}

									let listaUsuarios = JSON.parse(localStorage.getItem('db-usuarios-registrados') || '{}');

									if (listaUsuarios[username]) {
										if (listaUsuarios[username].password === password) {
											sessionStorage.setItem('sesion-usuario-activa', username);
											authError.classList.add('hidden');
											verificarSesion();
											location.reload();
											} else {
												authError.innerText = "⚠️ Contraseña incorrecta";
												authError.classList.remove('hidden');
												}
												} else {
													listaUsuarios[username] = { password: password, figuritas: [] };
													localStorage.setItem('db-usuarios-registrados', JSON.stringify(listaUsuarios));
													sessionStorage.setItem('sesion-usuario-activa', username);
													authError.classList.add('hidden');
													verificarSesion();
													location.reload();
													}
												});
											}

											if (btnLogout) {
												btnLogout.addEventListener('click', () => {
													sessionStorage.removeItem('sesion-usuario-activa');
													location.reload();
													});
													}

						// === 📅 LÓGICA DE EFEMÉRIDES MÚLTIPLES ===
						const seccionEfemeride = document.getElementById('seccion-efemeride');
						const efemerideContenido = document.getElementById('efemeride-contenido');

						const hoy = new Date();
						const dia = String(hoy.getDate()).padStart(2, '0');
						const mes = String(hoy.getMonth() + 1).padStart(2, '0');
						const fechaHoyTexto = ${dia}-${mes};

						let efemeridesDelDia = [];

						for (const artista of historias) {
							if (artista.trayectoria) {
								const coincidencias = artista.trayectoria.filter(h => h.fechaEfemeride === fechaHoyTexto);
								coincidencias.forEach(hito => {
									efemeridesDelDia.push({ hito, artista });
								});
							}
						}

					if (efemeridesDelDia.length > 0) {
							seccionEfemeride.classList.remove('hidden');
							efemerideContenido.innerHTML = efemeridesDelDia.map(({ hito, artista }, indice) => <div
							class="flex flex-col md:flex-row gap-6 items-start md:items-center ${indice > 0 ?
							'border-t border-purple-900/40 pt-6 mt-6' : ''}"> <div class="flex-1"> <span
								class="text-[10px] font-mono font-bold text-purple-400 bg-purple-950/60 border
								border-purple-900/50 px-2 py-0.5 rounded uppercase"> ${artista.nombre} </span> <h4
								class="text-2xl font-black text-white tracking-tight mt-2">${hito.etapa}</h4> <p
								class="text-zinc-300 text-sm mt-2 leading-relaxed max-w-2xl">${hito.detalle}</p>
								<div class="mt-4"> <a href="/${artista.slug}" class="text-xs font-mono font-bold
									text-purple-400 hover:text-purple-300 transition inline-flex items-center gap-1">
									Ver biografía completa <span>→</span> </a> </div> </div> ${hito.imagenDisco ?

						: ''} </div>).join('');
					}				

					// === 🎰 MOTOR DE SOBRES (VINCULADO AL USUARIO ACTIVO) ===
					const btnAbrir = document.getElementById('btn-abrir-sobre');
					const panelResultado = document.getElementById('resultado-sobre');
					const btnCerrar = document.getElementById('btn-cerrar-sobre');

					const poolDeFiguritas = historias.flatMap(artista =>
					(artista.trayectoria || [])
					.filter(hito => hito.numeroFigu)
					.map(hito => ({
						numero: hito.numeroFigu,
						nombre: hito.disco,
						imagen: hito.imagenDisco,
						artista: artista.nombre}))
					);

					function verificarTemporizador() {
						if (!btnAbrir) return;
						const usuarioActivo = sessionStorage.getItem('sesion-usuario-activa');
						if (!usuarioActivo) return;

						const ultimaApertura = localStorage.getItem(timer-sobre-${usuarioActivo})

						if (ultimaApertura) {
							const ahora = new Date().getTime();
							const tiempoPasado = ahora - Number(ultimaApertura);
							const veinticuatroHoras = 24 * 60 * 60 * 1000;

							if (tiempoPasado < veinticuatroHoras) {
								btnAbrir.disabled = true;
								btnAbrir.classList.remove('bg-purple-600', 'hover:bg-purple-500');
								btnAbrir.classList.add('bg-zinc-800', 'text-zinc-500', 'cursor-not-allowed');

								const tiempoRestante = veinticuatroHoras - tiempoPasado;
								const horas = Math.floor((tiempoRestante % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
								const minutos = Math.floor((tiempoRestante % (1000 * 60 * 60)) / (1000 * 60));
								const segundos = Math.floor((tiempoRestante % (1000 * 60)) / 1000);

								btnAbrir.innerText = ⏱️ Próximo en: ${horas}h ${minutos}m ${segundos}s;
								setTimeout(verTemporizador, 1000);
								return;
							}
						}

						btnAbrir.disabled = false;
						btnAbrir.classList.add('bg-purple-600', 'hover:bg-purple-500');
						btnAbrir.classList.remove('bg-zinc-800', 'text-zinc-500', 'cursor-not-allowed');
						btnAbrir.innerText = "🎁 Abrir Paquete";
					}

					document.addEventListener('DOMContentLoaded', verificarTemporizador);

					if (btnAbrir) {
						btnAbrir.addEventListener('click', () => {
							const usuarioActivo = sessionStorage.getItem('sesion-usuario-activa');
							if (!usuarioActivo || poolDeFiguritas.length === 0 || btnAbrir.disabled) return;

							btnAbrir.innerText = "⏳ Abriendo...";
							btnAbrir.disabled = true;

					let sobreGanado = [];
					for (let i = 0; i < 3; i++) {
						const indiceRandom = Math.floor(Math.random() * poolDeFiguritas.length);
						sobreGanado.push(poolDeFiguritas[indiceRandom]);
					}

					// 🔒 GUARDADO CORRECTO EN EL PERFIL DEL USUARIO ACTIVO
							const usuarioActivo = sessionStorage.getItem('sesion-usuario-activa');
					if (usuarioActivo) {
						let dbUsuarios = JSON.parse(localStorage.getItem('db-usuarios-registrados') || '{}');
						
						if (!dbUsuarios[usuarioActivo].figuritas) {
							dbUsuarios[usuarioActivo].figuritas = [];
						}
						
						sobreGanado.forEach(figu => {
							if (!dbUsuarios[usuarioActivo].figuritas.includes(Number(figu.numero))) {
								dbUsuarios[usuarioActivo].figuritas.push(Number(figu.numero));
							}
						});

						localStorage.setItem('db-usuarios-registrados', JSON.stringify(dbUsuarios));
					}


						localStorage.setItem('db-usuarios-registrados', JSON.stringify(dbUsuarios));
						
						// Guardamos el tiempo usando el nombre del usuario activo
						const ahoraMismo = new Date().getTime();
						localStorage.setItem(`timer-sobre-${usuarioActivo}`, ahoraMismo.toString());
					}


						setTimeout(() => {
							panelResultado.classList.remove('hidden');
							panelResultado.querySelector('.grid').innerHTML = sobreGanado.map(figu => <div 
							class="bg-zinc-950 border border-purple-500/30 rounded-xl p-2 text-center transition hover:border-purple-500"> <div class="aspect-square rounded-lg overflow-hidden border border-zinc-800"> <img src="${figu.imagen}" alt="${figu.nombre}" class="w-full h-full object-cover" /> </div> <span class="text-[10px] font-mono text-purple-400 font-bold block mt-2">N° ${figu.numero}</span> <h5 class="text-white text-[11px] font-bold truncate mt-0.5">${figu.nombre}</h5> </div>).join('');

							verificarTemporizador();
						}, 800);
					});
				}

				if (btnCerrar) {
					btnCerrar.addEventListener('click', () => {
						panelResultado.classList.add('opacity-0', 'scale-95');
						setTimeout(() => {
							panelResultado.classList.add('hidden');
							panelResultado.classList.remove('opacity-0', 'scale-95');
							panelResultado.querySelector('.grid').innerHTML = '';
						}, 200);
					});
				}

				// === 🔍 LÓGICA DEL BUSCADOR PREDICTIVO ===
				const input = document.getElementById('buscador-input');
				const resultadosContenedor = document.getElementById('buscador-resultados');

				input.addEventListener('input', (e) => {
					const valor = e.target.value.toLowerCase().trim();
					if (valor === '') {
						resultadosContenedor.classList.add('hidden');
						resultadosContenedor.innerHTML = '';
						return;
					}

					const filtrados = historias.filter(artista =>
					artista.nombre.toLowerCase().includes(valor) ||
					artista.genero.toLowerCase().includes(valor) ||
					artista.subgenero.toLowerCase().includes(valor) ||
					artista.pais.toLowerCase().includes(valor)
				);

				if (filtrados.length > 0) {
					resultadosContenedor.classList.remove('hidden');
					resultadosContenedor.innerHTML = filtrados.map(artista => <a href="/${artista.slug}"
					 class="flex items-center gap-4 px-4 py-3 hover:bg-zinc-800/60 transition group 
					 border-b border-zinc-800/40 last:border-0"> <div class="w-10 h-10 rounded-full 
					 overflow-hidden shrink-0 border border-zinc-700"> <img src="${artista.imagen}" 
					 alt="${artista.nombre}" class="w-full h-full object-cover" /> </div> <div 
					 class="flex-1 text-left"> <h4 class="text-sm font-bold text-zinc-200 group-
					 hover:text-purple-400 transition">${artista.nombre}</h4> <p class="text-[10px] font-
					 mono text-zinc-500 mt-0.5">${artista.pais} • ${artista.subgenero}</p> </div> <span 
					 class="text-zinc-600 group-hover:text-purple-400 transition text-sm font-mono pr-
					 1">→</span> </a>).join('');
					} else {
						resultadosContenedor.classList.remove('hidden');
						resultadosContenedor.innerHTML = <div class="px-4 py-4 text-xs font-mono text-

---
// Panel Secreto de Administración de Sónica Protegido
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Panel de Administración | Sónica</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen font-sans p-8 relative selection:bg-purple-500 selection:text-white">
    
    <!-- 🔒 CAPA DE SEGURIDAD: PANTALLA DE BLOQUEO OBLIGATORIA -->
    <div id="bloqueo-admin" class="fixed inset-0 bg-black backdrop-blur-xl flex flex-col items-center justify-center z-50">
      <div class="bg-zinc-900 border border-zinc-800 p-8 rounded-3xl max-w-sm w-full mx-4 shadow-2xl text-center">
        <span class="text-4xl">🔑</span>
        <h3 class="text-xl font-black text-white tracking-tight mt-4">Acceso Restringido</h3>
        <p class="text-zinc-500 text-xs mt-1 mb-6">Ingresá la Clave Maestra de Administrador para ver las estadísticas.</p>
        
        <input 
          type="password" 
          id="clave-admin-input" 
          class="w-full bg-zinc-950 border border-zinc-800 focus:border-purple-500 rounded-xl p-3 text-sm text-center text-white focus:outline-none transition mb-4 font-mono tracking-widest" 
          placeholder="••••••••" 
        />
        
        <button id="btn-entrar-admin" class="w-full bg-purple-600 hover:bg-purple-500 text-white text-xs font-mono font-bold p-3 rounded-xl transition shadow-lg shadow-purple-900/30">
          Desbloquear Panel
        </button>
        <p id="error-admin" class="text-red-400 text-[10px] font-mono mt-3 hidden">⚠️ Clave incorrecta. Acceso denegado.</p>
      </div>
    </div>

    <!-- Luces de Fondo sutiles -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-[300px] pointer-events-none opacity-10 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-purple-500 via-transparent to-transparent -z-10"></div>

    <!-- Contenido del Panel (Oculto por defecto hasta que pongas la clave) -->
    <div id="contenido-admin" class="max-w-4xl mx-auto opacity-0 transition-opacity duration-500">
      <header class="border-b border-zinc-900 pb-6 mb-8">
        <a href="/" class="text-xs font-mono text-zinc-500 hover:text-purple-400 transition block mb-2">← Volver a la Portada</a>
        <h1 class="text-3xl font-black tracking-tight text-white flex items-center gap-2">
          <span>⚙️</span> PANEL DE CONTROL SECRETO
        </h1>
        <p class="text-zinc-500 text-xs mt-1">Monitoreo de perfiles creados e interacción con el Álbum Virtual.</p>
      </header>

      <main class="bg-zinc-900/40 border border-zinc-900 rounded-2xl p-6 backdrop-blur-sm shadow-2xl">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-xs font-mono text-purple-400 uppercase tracking-widest font-bold">👤 Cuentas Registradas en el Sistema</h3>
          <span id="contador-usuarios" class="text-xs font-mono bg-zinc-950 border border-zinc-800 px-3 py-1 rounded-full text-zinc-400">Total: 0 usuarios</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-zinc-800 text-zinc-500 font-mono text-[10px] uppercase tracking-wider">
                <th class="pb-3 pl-4">Usuario</th>
                <th class="pb-3">Contraseña</th>
                <th class="pb-3 text-center">Figuritas Pegadas</th>
                <th class="pb-3 text-right pr-4">Estado del Álbum</th>
              </tr>
            </thead>
            <tbody id="tabla-usuarios-cuerpo" class="divide-y divide-zinc-900/60 font-medium text-sm text-zinc-300"></tbody>
          </table>
        </div>

        <div id="sin-usuarios" class="text-center py-12 text-zinc-600 font-mono text-xs hidden">
          📭 Todavía no se crearon perfiles de usuario en este navegador.
        </div>
      </main>
    </div>

    <!-- 🧠 LÓGICA DE PROTECCIÓN ABSOLUTA -->
    <script>
      // 🔐 CONFIGURÁ TU CONTRASEÑA MAESTRA AQUÍ:
      // Cambiá "fabian2026" por la clave secreta que vos quieras usar para entrar
      const CLAVE_MAESTRA = "fabian2026"; 

      const capaBloqueo = document.getElementById('bloqueo-admin');
      const capaContenido = document.getElementById('contenido-admin');
      const inputClave = document.getElementById('clave-admin-input');
      const btnEntrar = document.getElementById('btn-entrar-admin');
      const txtError = document.getElementById('error-admin');

      if (btnEntrar && inputClave) {
        btnEntrar.addEventListener('click', () => {
          const claveIngresada = inputClave.value.trim();

          if (claveIngresada === CLAVE_MAESTRA) {
            // Si la clave es correcta, destruimos la pantalla de bloqueo y revelamos los datos
            if (capaBloqueo) capaBloqueo.remove();
            if (capaContenido) {
              capaContenido.classList.remove('opacity-0');
              capaContenido.classList.add('opacity-100');
            }
            cargarDatosPanel();
          } else {
            // Si le pifia, le mostramos el error rojo
            if (txtError) txtError.classList.remove('hidden');
            inputClave.value = "";
          }
        });
      }

      function cargarDatosPanel() {
        const tabla = document.getElementById('tabla-usuarios-cuerpo');
        const contador = document.getElementById('contador-usuarios');
        const avisoVacio = document.getElementById('sin-usuarios');

        const dbUsuarios = JSON.parse(localStorage.getItem('db-usuarios-registrados') || '{}');
        const nombresUsuarios = Object.keys(dbUsuarios);

        if (contador) contador.innerText = `Total: ${nombresUsuarios.length} usuarios`;

        if (nombresUsuarios.length === 0) {
          if (avisoVacio) avisoVacio.classList.remove('hidden');
          return;
        }

        if (tabla) {
          tabla.innerHTML = nombresUsuarios.map(username => {
            const datos = dbUsuarios[username];
            const totalFigus = datos.figuritas ? datos.figuritas.length : 0;
            const porcentaje = Math.min(Math.round((totalFigus / 3) * 100), 100);

            return `
              <tr class="hover:bg-zinc-900/40 transition">
                <td class="py-4 pl-4 font-bold text-zinc-100 flex items-center gap-2">👤 ${username}</td>
                <td class="py-4 font-mono text-zinc-500 text-xs font-bold">${datos.password}</td>
                <td class="py-4 text-center font-mono font-bold text-purple-400">${totalFigus}</td>
                <td class="py-4 text-right pr-4">
                  <span class="text-[10px] font-mono font-bold bg-purple-950/40 border border-purple-900/40 text-purple-300 px-2 py-0.5 rounded">${porcentaje}% Completado</span>
                </td>
              </tr>
            `;
          }).join('');
        }
      }
    </script>
  </body>
</html>

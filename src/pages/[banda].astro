---
import { client, urlFor } from '../sanityClient';

// 🔌 Generamos las rutas fijas para internet según los artistas en la nube
export async function getStaticPaths() {
  const artistas = await client.fetch(`*[_type == "banda"]{ "slug": slug.current }`);
  return artistas.map((artista) => ({
    params: { banda: artista.slug },
  }));
}

const { banda } = Astro.params;

// 🧠 Traemos la información detallada del artista activo
const artista = await client.fetch(
  `*[_type == "banda" && slug.current == $banda][0]`,
  { banda }
);

// Buscamos si hay algún solista o banda vinculada cargada en el sistema
const bandaMadre = artista.tipo === 'solista' && artista.vinculadoA 
  ? await client.fetch(`*[_type == "banda" && slug.current == $vinculo][0]`, { vinculo: artista.vinculadoA })
  : null;

const proyectoSolista = artista.tipo === 'banda'
  ? await client.fetch(`*[_type == "banda" && tipo == "solista" && vinculadoA == $slug][0]`, { slug: artista.slug?.current })
  : null;

// Recomendaciones automáticas por mismo género musical
const historiasTotales = await client.fetch(`*[_type == "banda"]`);
const recomendados = historiasTotales
  .filter((item) => item.genero === artista.genero && item.slug?.current !== artista.slug?.current && item.slug?.current !== artista.vinculadoA)
  .slice(0, 2);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{artista.nombre} | Biografía Completa</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen font-sans relative overflow-x-hidden selection:bg-purple-500 selection:text-white">
    
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-[300px] pointer-events-none opacity-10 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-purple-500 via-transparent to-transparent -z-10"></div>

    <div class="max-w-4xl mx-auto px-6 pt-8 pb-24">
      
      <div class="mb-12">
        <a href="/" class="inline-flex items-center gap-2 text-xs font-mono text-zinc-500 hover:text-purple-400 transition group">
          <span class="transform group-hover:-translate-x-1 transition duration-200">←</span> Volver al catálogo
        </a>
      </div>

      <header class="flex flex-col md:flex-row gap-8 items-center md:items-end border-b border-zinc-900 pb-12 mb-12">
        <div class="w-48 h-48 md:w-56 md:h-56 shrink-0 rounded-2xl overflow-hidden shadow-2xl border border-zinc-800 bg-zinc-900">
          <img src={urlFor(artista.imagen)} alt={artista.nombre} class="w-full h-full object-cover"/>
        </div>

        <div class="text-center md:text-left flex-1">
          <div class="flex flex-wrap justify-center md:justify-start items-center gap-2 text-[10px] font-mono tracking-widest text-purple-400 uppercase">
            <span>{artista.pais}</span>
            <span class="text-zinc-800">•</span>
            <span>{artista.genero}</span>
            <span class="text-zinc-800">•</span>
            <span class="text-zinc-400">{artista.subgenero}</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-black mt-3 tracking-tight text-white">{artista.nombre}</h1>
          <p class="text-xs font-mono text-zinc-500 mt-2">Período de actividad: {artista.periodo}</p>
        </div>
      </header>

      <main>
        {bandaMadre && (
          <div class="mb-8 bg-purple-950/20 border border-purple-900/40 p-4 rounded-xl flex items-center justify-between gap-4">
            <p class="text-xs text-purple-300 font-medium">✨ Conoce los orígenes de este artista en su banda madre:</p>
            <a href={`/${bandaMadre.slug?.current}`} class="bg-purple-600 hover:bg-purple-500 text-white text-xs font-mono font-bold px-3 py-1.5 rounded-lg transition shrink-0">Ver {bandaMadre.nombre} →</a>
          </div>
        )}

        <!-- 📖 Texto Biográfico de Introducción Procesado por Párrafos Reales -->
        {artista.historiaLarga && (
          <section class="mb-16">
            <h3 class="text-xs font-mono text-zinc-500 uppercase tracking-widest mb-4">📖 Biografía General</h3>
            <div class="bg-zinc-900/10 border border-zinc-900 p-6 rounded-2xl space-y-4">
              {artista.historiaLarga.split('\n').filter(párrafo => párrafo.trim() !== '').map((párrafo) => (
                <p class="text-zinc-300 text-base leading-relaxed text-justify">
                  {párrafo}
                </p>
              ))}
            </div>
          </section>
        )}

        <h2 class="text-xs font-mono text-zinc-500 uppercase tracking-widest mb-12 flex items-center gap-2">
          <span>⏱️</span> Línea de Tiempo e Historias Ocultas
        </h2>
        
        <!-- Línea de tiempo adaptable -->
        <div class="relative border-l border-zinc-800/80 ml-4 md:ml-40 space-y-12 mb-24">
          {artista.trayectoria && artista.trayectoria.map((elemento) => (
            <div class="relative pl-8 md:pl-12 group">
              
              <div class="md:absolute md:-left-44 md:top-1 md:w-36 md:text-right font-mono text-xs font-bold text-purple-400 group-hover:text-purple-300 transition duration-300 mb-2 md:mb-0">
                {elemento.etapa}
              </div>

              <div class={`absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-zinc-950 border-2 transition-all duration-300 ring-4 ring-zinc-950 ${elemento.tipoHito === 'curiosidad' ? 'border-amber-500 bg-amber-500/10' : 'border-purple-500'}`}></div>
              
              <div class={`p-6 rounded-xl transition-all duration-300 border ${elemento.tipoHito === 'curiosidad' ? 'bg-amber-950/5 border-amber-900/30 group-hover:border-amber-500/50' : 'bg-zinc-900/10 border-zinc-900/60 group-hover:border-zinc-800'}`}>
                
                {elemento.tipoHito === 'curiosidad' && (
                  <div class="flex items-center gap-1.5 text-amber-400 font-mono text-[10px] uppercase tracking-wider mb-2 font-bold">
                    <span>💡</span> Dato Curioso / Secreto de Estudio
                  </div>
                )}

                <p class="text-zinc-300 text-sm leading-relaxed">
                  {elemento.detalle}
                </p>

                {elemento.disco && elemento.imagenDisco && (
                  <div class="mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-zinc-950/60 border border-zinc-800/60 p-4 rounded-xl max-w-xl group/album hover:border-zinc-700 transition">
                    <div class="flex items-center gap-4">
                      <div class="w-16 h-16 rounded-lg overflow-hidden shrink-0 border border-zinc-800 shadow-md">
                        <img src={urlFor(elemento.imagenDisco)} alt={elemento.disco} class="w-full h-full object-cover group-hover/album:scale-105 transition duration-300" />
                      </div>
                      <div>
                        <span class="text-[9px] font-mono text-zinc-500 uppercase tracking-wider block">Álbum Oficial</span>
                        <h4 class="text-sm font-bold text-zinc-200 mt-0.5">{elemento.disco}</h4>
                      </div>
                    </div>
                  </div>
                )}
              </div>

            </div>
          ))}
        </div>

        <!-- Sugerencia de Carrera Solista vinculada -->
        {proyectoSolista && (
          <section class="border-t border-zinc-900 pt-12 mb-12">
            <h3 class="text-xs font-mono text-zinc-500 uppercase tracking-widest mb-6">🎙️ Carrera Solista Relacionada:</h3>
            <div class="max-w-md">
              <a href={`/${proyectoSolista.slug?.current}`} class="flex items-center gap-4 bg-purple-950/10 hover:bg-purple-950/20 border border-purple-900/30 hover:border-purple-800 p-4 rounded-xl transition group">
                <div class="w-16 h-16 rounded-lg overflow-hidden shrink-0 border border-purple-900/20">
                  <img src={urlFor(proyectoSolista.imagen)} alt={proyectoSolista.nombre} class="w-full h-full object-cover" />
                </div>
                <div class="flex-1 text-left">
                  <span class="text-[9px] font-mono text-purple-400 uppercase font-bold">Etapa Solista</span>
                  <h4 class="text-base font-bold text-zinc-100 group-hover:text-purple-400 transition mt-0.5">{proyectoSolista.nombre}</h4>
                </div>
                <span class="text-purple-500 group-hover:text-purple-400 transition text-sm font-mono pr-2">→</span>
              </a>
            </div>
          </section>
        )}

        <!-- Otras recomendaciones automáticas -->
        {recomendados.length > 0 && (
          <section class="border-t border-zinc-900 pt-12">
            <h3 class="text-xs font-mono text-zinc-500 uppercase tracking-widest mb-6">✨ Otras trayectorias recomendadas:</h3>
            <div class="grid sm:grid-cols-2 gap-6">
              {recomendados.map((item) => (
                <a href={`/${item.slug?.current}`} class="flex items-center gap-4 bg-zinc-900/30 hover:bg-zinc-900 border border-zinc-900 hover:border-zinc-800 p-4 rounded-xl transition group">
                  <div class="w-16 h-16 rounded-lg overflow-hidden shrink-0 border border-zinc-800">
                    <img src={urlFor(item.imagen)} alt={item.nombre} class="w-full h-full object-cover" />
                  </div>
                  <div class="flex-1 text-left">
                    <span class="text-[9px] font-mono text-purple-400 uppercase">{item.subgenero}</span>
                    <h4 class="text-base font-bold text-zinc-200 group-hover:text-purple-400 transition mt-0.5">{item.nombre}</h4>
                  </div>
                  <span class="text-zinc-600 group-hover:text-purple-400 transition text-sm font-mono pr-2">→</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </main>

    </div>
  </body>
</html>
